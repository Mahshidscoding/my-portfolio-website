{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/about",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/commandFreak",
        "destination": "/command.html"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/projects",
        "destination": "/projects.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|mp4|webm|mov|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
