{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/about",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/commandFreak",
        "destination": "/command.html"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/projects",
        "destination": "/projects.html"
      }
    ]
  }
}